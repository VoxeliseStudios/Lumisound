[Unit]
Description=Refresh Lumisound YouTube cookies when the bridge marks them stale

[Path]
# The host path mounted as YTDLP_CACHE_DIR in ~/Projects/web-stack/docker-compose.yml.
PathExists=%h/lumisound/cache/yt-dlp/.cookies_stale
PathChanged=%h/lumisound/cache/yt-dlp/.cookies_stale
Unit=lumisound-youtube-cookies-refresh.service

[Install]
WantedBy=default.target
